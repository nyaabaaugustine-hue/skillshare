# Reference template only: the Cloudflare Worker does not load this .env file.
# Never commit real credentials. Use .dev.vars for local Wrangler secrets and
# `npx wrangler secret put <NAME>` for deployed Worker secrets.
#
#   RESEND_API_KEY  Resend dashboard -> API Keys -> Create API Key (re_...)
#   MAIL_FROM       Must belong to a domain verified in Resend
RESEND_API_KEY=
MAIL_FROM=SkillsBridge Academy <reports@skillsbridge.academy>

# Neon Postgres:
#   1. In Neon Console, choose the project and branch, then click Connect.
#   2. Select the database and role; copy the pooled connection string for
#      application/serverless traffic. Keep Neon's SSL parameters (sslmode=require).
#   3. Treat the full URI as a password: never put it in Flutter or commit it.
#
# The guardian_mailer Worker does not currently query Neon, so DATABASE_URL is
# not read by this code. If Neon access is added, put the URI in .dev.vars for
# local Wrangler use and set it with `npx wrangler secret put DATABASE_URL`
# for deployment. Neon Auth is the current tutor sign-in validator.
DATABASE_URL=
