<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (Android 11 and below, and the window behind the app
     while Flutter starts): white background with the brand logo centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
    <item
        android:gravity="center"
        android:drawable="@drawable/launch_logo" />
</layer-list>
