# Copy to android/keystore.properties and fill in the upload keystore details.
# keystore.properties is git-ignored — never commit real credentials.
# storeFile is resolved relative to android/app, so ../upload-keystore.jks
# means android/upload-keystore.jks (an absolute path also works).
storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
