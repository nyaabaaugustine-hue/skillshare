<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ ignores windowBackground for the launch screen and draws
         its own: an animated icon on a solid colour. White matches the in-app
         splash on every device, light or dark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
